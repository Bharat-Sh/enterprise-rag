# Copy to `.env` for local development.
#
# Env var naming: RAG_<FIELD> for top-level settings, RAG_<GROUP>__<FIELD> for
# nested groups. The double underscore is `env_nested_delimiter` in
# src/rag/core/config.py — a single underscore will NOT work.

# --- Application -----------------------------------------------------------
RAG_ENVIRONMENT=local
RAG_SERVICE_NAME=rag-api
RAG_LOG_LEVEL=INFO
# RAG_LOG_FORMAT=console        # unset => console for local, json otherwise
# RAG_DOCS_ENABLED=true         # unset => enabled unless staging/prod

# --- Server ----------------------------------------------------------------
RAG_SERVER__HOST=0.0.0.0
RAG_SERVER__PORT=8000
RAG_SERVER__RELOAD=true

# --- PostgreSQL (source of truth — see docs/adr/0001) ----------------------
RAG_DATABASE__HOST=localhost
RAG_DATABASE__PORT=5432
RAG_DATABASE__USER=rag
RAG_DATABASE__PASSWORD=rag
RAG_DATABASE__NAME=rag
RAG_DATABASE__POOL_SIZE=10

# --- Redis (cache, rate limiting) -----------------------------------------
RAG_REDIS__HOST=localhost
RAG_REDIS__PORT=6379
RAG_REDIS__DB=0
# RAG_REDIS__PASSWORD=

# --- Qdrant (derived vector index — see docs/adr/0001) --------------------
RAG_QDRANT__HOST=localhost
RAG_QDRANT__PORT=6333
RAG_QDRANT__COLLECTION=rag_chunks

# --- Model service (BGE-M3 + reranker, GPU — see docs/adr/0004) -----------
RAG_MODEL_SERVICE__BASE_URL=http://localhost:8001
RAG_MODEL_SERVICE__TIMEOUT_SECONDS=30
