# Copy to `.env` for local development.
#
# Env var naming: RAG_<FIELD> for top-level settings, RAG_<GROUP>__<FIELD> for
# nested groups. The double underscore is `env_nested_delimiter` in
# src/rag/core/config.py — a single underscore will NOT work.

# --- Application -----------------------------------------------------------
RAG_ENVIRONMENT=local
RAG_SERVICE_NAME=rag-api
RAG_LOG_LEVEL=INFO
# RAG_LOG_FORMAT=console        # unset => console for local, json otherwise
# RAG_DOCS_ENABLED=true         # unset => enabled unless staging/prod

# --- Server ----------------------------------------------------------------
RAG_SERVER__HOST=0.0.0.0
RAG_SERVER__PORT=8000
RAG_SERVER__RELOAD=true

# --- Authentication (see docs/adr/0007) ------------------------------------
# Signing key. Leave BOTH unset locally and the process generates an ephemeral
# Ed25519 keypair at boot — tokens then die on restart, which is fine here and
# is why no key is committed to this repository. In staging or production a
# missing key is a boot-time failure, not a warning.
#
#   uv run rag-admin generate-key            # prints a PEM to stdout
#
# RAG_AUTH__PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# RAG_AUTH__PRIVATE_KEY_PATH=/run/secrets/rag-signing-key.pem
# RAG_AUTH__ALGORITHM=EdDSA               # or RS256 for older verifiers
# RAG_AUTH__RETIRED_PUBLIC_KEYS_PEM=      # keep verifying during a rotation

RAG_AUTH__ISSUER=http://localhost:8000    # must be https outside local
RAG_AUTH__AUDIENCE=rag-api
RAG_AUTH__ACCESS_TOKEN_TTL_SECONDS=900    # 15 minutes
RAG_AUTH__REFRESH_TOKEN_TTL_SECONDS=2592000  # 30 days
# Argon2id, at the OWASP minimum. Peak memory is cost x concurrent logins.
RAG_AUTH__ARGON2_TIME_COST=2
RAG_AUTH__ARGON2_MEMORY_COST_KIB=19456
RAG_AUTH__PASSWORD_MIN_LENGTH=12

# --- Rate limiting (see docs/adr/0008) -------------------------------------
# In-process token buckets, so these are per worker process until M9 adds the
# Redis adapter. Keep RAG_SERVER__WORKERS at 1 and scale replicas instead.
RAG_RATE_LIMIT__ENABLED=true
RAG_RATE_LIMIT__TENANT_REQUESTS_PER_MINUTE=600
RAG_RATE_LIMIT__TENANT_BURST=120
RAG_RATE_LIMIT__LOGIN_ATTEMPTS_PER_MINUTE=10
RAG_RATE_LIMIT__LOGIN_BURST=5

# --- Ingestion (see docs/adr/0009) -----------------------------------------
# Where uploaded bytes and extracted text are stored. The filesystem adapter is
# single-node: correct locally and in a one-container deployment, wrong the
# moment there are two replicas. An S3 adapter behind the same port replaces it.
RAG_INGESTION__BLOB_ROOT=./var/blobs
RAG_INGESTION__MAX_UPLOAD_BYTES=52428800   # 50 MiB, enforced mid-stream
RAG_INGESTION__CHUNK_TARGET_TOKENS=512
RAG_INGESTION__CHUNK_OVERLAP_TOKENS=64     # must be < target, or chunking stalls
RAG_INGESTION__PARSE_TIMEOUT_SECONDS=120

# Limits on hostile input (see docs/adr/0010). A DOCX is a zip of XML, so it
# arrives carrying a decompression bomb and entity expansion by default; these
# are what close those, and the timeout above is only the backstop.
RAG_INGESTION__MAX_PDF_PAGES=2000
RAG_INGESTION__MAX_EXTRACTED_BYTES=104857600   # 100 MiB after decompression
RAG_INGESTION__MAX_COMPRESSION_RATIO=200       # ordinary documents are under 20:1
RAG_INGESTION__MAX_ARCHIVE_ENTRIES=2000

# --- Worker ----------------------------------------------------------------
# One job at a time per process; scale by running more processes.
# RAG_WORKER__NAME=                        # defaults to the hostname
RAG_WORKER__POLL_INTERVAL_SECONDS=1
RAG_WORKER__BATCH_SIZE=1
# Must exceed the slowest realistic job, or a healthy worker's job is stolen
# mid-flight and run twice.
RAG_WORKER__STALLED_AFTER_SECONDS=900

# --- PostgreSQL (source of truth — see docs/adr/0001) ----------------------
RAG_DATABASE__HOST=localhost
RAG_DATABASE__PORT=5432
RAG_DATABASE__USER=rag
RAG_DATABASE__PASSWORD=rag
RAG_DATABASE__NAME=rag
RAG_DATABASE__POOL_SIZE=10

# --- Redis (cache, rate limiting) -----------------------------------------
RAG_REDIS__HOST=localhost
RAG_REDIS__PORT=6379
RAG_REDIS__DB=0
# RAG_REDIS__PASSWORD=

# --- Qdrant (derived vector index — see docs/adr/0001) --------------------
RAG_QDRANT__HOST=localhost
RAG_QDRANT__PORT=6333
RAG_QDRANT__COLLECTION=rag_chunks

# --- Model service (BGE-M3 + reranker, GPU — see docs/adr/0004) -----------
RAG_MODEL_SERVICE__BASE_URL=http://localhost:8001
RAG_MODEL_SERVICE__TIMEOUT_SECONDS=30
