# Copy to `.env` for local development.
#
# Env var naming: RAG_<FIELD> for top-level settings, RAG_<GROUP>__<FIELD> for
# nested groups. The double underscore is `env_nested_delimiter` in
# src/rag/core/config.py — a single underscore will NOT work.

# --- Application -----------------------------------------------------------
RAG_ENVIRONMENT=local
RAG_SERVICE_NAME=rag-api
RAG_LOG_LEVEL=INFO
# RAG_LOG_FORMAT=console        # unset => console for local, json otherwise
# RAG_DOCS_ENABLED=true         # unset => enabled unless staging/prod

# --- Server ----------------------------------------------------------------
RAG_SERVER__HOST=0.0.0.0
RAG_SERVER__PORT=8000
RAG_SERVER__RELOAD=true

# --- Authentication (see docs/adr/0007) ------------------------------------
# Signing key. Leave BOTH unset locally and the process generates an ephemeral
# Ed25519 keypair at boot — tokens then die on restart, which is fine here and
# is why no key is committed to this repository. In staging or production a
# missing key is a boot-time failure, not a warning.
#
#   uv run rag-admin generate-key            # prints a PEM to stdout
#
# RAG_AUTH__PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# RAG_AUTH__PRIVATE_KEY_PATH=/run/secrets/rag-signing-key.pem
# RAG_AUTH__ALGORITHM=EdDSA               # or RS256 for older verifiers
# RAG_AUTH__RETIRED_PUBLIC_KEYS_PEM=      # keep verifying during a rotation

RAG_AUTH__ISSUER=http://localhost:8000    # must be https outside local
RAG_AUTH__AUDIENCE=rag-api
RAG_AUTH__ACCESS_TOKEN_TTL_SECONDS=900    # 15 minutes
RAG_AUTH__REFRESH_TOKEN_TTL_SECONDS=2592000  # 30 days
# Argon2id, at the OWASP minimum. Peak memory is cost x concurrent logins.
RAG_AUTH__ARGON2_TIME_COST=2
RAG_AUTH__ARGON2_MEMORY_COST_KIB=19456
RAG_AUTH__PASSWORD_MIN_LENGTH=12

# --- Rate limiting (see docs/adr/0008) -------------------------------------
# In-process token buckets, so these are per worker process until M9 adds the
# Redis adapter. Keep RAG_SERVER__WORKERS at 1 and scale replicas instead.
RAG_RATE_LIMIT__ENABLED=true
RAG_RATE_LIMIT__TENANT_REQUESTS_PER_MINUTE=600
RAG_RATE_LIMIT__TENANT_BURST=120
RAG_RATE_LIMIT__LOGIN_ATTEMPTS_PER_MINUTE=10
RAG_RATE_LIMIT__LOGIN_BURST=5

# --- Ingestion (see docs/adr/0009) -----------------------------------------
# Where uploaded bytes and extracted text are stored. The filesystem adapter is
# single-node: correct locally and in a one-container deployment, wrong the
# moment there are two replicas. An S3 adapter behind the same port replaces it.
RAG_INGESTION__BLOB_ROOT=./var/blobs
RAG_INGESTION__MAX_UPLOAD_BYTES=52428800   # 50 MiB, enforced mid-stream
RAG_INGESTION__CHUNK_TARGET_TOKENS=512
RAG_INGESTION__CHUNK_OVERLAP_TOKENS=64     # must be < target, or chunking stalls
RAG_INGESTION__PARSE_TIMEOUT_SECONDS=120

# Limits on hostile input (see docs/adr/0010). A DOCX is a zip of XML, so it
# arrives carrying a decompression bomb and entity expansion by default; these
# are what close those, and the timeout above is only the backstop.
RAG_INGESTION__MAX_PDF_PAGES=2000
RAG_INGESTION__MAX_EXTRACTED_BYTES=104857600   # 100 MiB after decompression
RAG_INGESTION__MAX_COMPRESSION_RATIO=200       # ordinary documents are under 20:1
RAG_INGESTION__MAX_ARCHIVE_ENTRIES=2000

# --- Worker ----------------------------------------------------------------
# One job at a time per process; scale by running more processes.
# RAG_WORKER__NAME=                        # defaults to the hostname
RAG_WORKER__POLL_INTERVAL_SECONDS=1
RAG_WORKER__BATCH_SIZE=1
# Must exceed the slowest realistic job, or a healthy worker's job is stolen
# mid-flight and run twice.
RAG_WORKER__STALLED_AFTER_SECONDS=900

# --- PostgreSQL (source of truth — see docs/adr/0001) ----------------------
RAG_DATABASE__HOST=localhost
RAG_DATABASE__PORT=5432
RAG_DATABASE__USER=rag
RAG_DATABASE__PASSWORD=rag
RAG_DATABASE__NAME=rag
RAG_DATABASE__POOL_SIZE=10

# --- Redis (cache, rate limiting) -----------------------------------------
RAG_REDIS__HOST=localhost
RAG_REDIS__PORT=6379
RAG_REDIS__DB=0
# RAG_REDIS__PASSWORD=

# --- Qdrant (derived vector index — see docs/adr/0001, 0012) --------------
RAG_QDRANT__HOST=localhost
RAG_QDRANT__PORT=6333
RAG_QDRANT__COLLECTION=rag_chunks
# Must match the embedding model's width. A collection created at the wrong size
# rejects every insert, and does so on the first ingestion rather than at boot.
RAG_QDRANT__VECTOR_SIZE=1024
# Run the client's embedded local mode instead of connecting to a server, which
# is how the vector store is exercised on a machine with no Docker. Filters are
# correct but UNINDEXED — the client warns that payload indexes have no effect —
# so a local run proves behaviour and says nothing about performance. Use
# ":memory:" for a throwaway store, or a directory path to persist.
# Leave unset to talk to a real server.
# RAG_QDRANT__LOCAL_PATH=./var/qdrant
# RAG_QDRANT__API_KEY=

# Chunks embedded and indexed per round trip. Bounds worker memory: a
# 2000-page PDF is ~10k chunks, and holding every dense vector at once would be
# ~80 MB before sparse weights.
RAG_INGESTION__EMBED_BATCH_SIZE=32

# --- Model service (BGE-M3 + reranker, GPU — see docs/adr/0004, 0011) -----
# The API and worker reach the GPU over HTTP and stay CPU-only. Nothing here
# needs to be running before M6: the readiness check reports it as an *optional*
# dependency, so the API is ready with the model service down.
RAG_MODEL_SERVICE__BASE_URL=http://localhost:8001
RAG_MODEL_SERVICE__TIMEOUT_SECONDS=30
# Shared secret. Unset locally; set it in any deployment where something other
# than this machine can reach the service — an open embedding endpoint is free
# GPU time for whoever finds it. Must match MODEL_SERVICE_API_KEY on the server.
# RAG_MODEL_SERVICE__API_KEY=
# Retries for transient failures only. Small on purpose: the job queue already
# retries with exponential backoff, and stacking the two turns a 30-second
# timeout into minutes of a worker held on a service that is down.
RAG_MODEL_SERVICE__MAX_RETRIES=2
RAG_MODEL_SERVICE__MAX_TEXTS_PER_REQUEST=32

# --- Chunk tokenizer (see docs/adr/0011) -----------------------------------
# `heuristic` is a character-ratio estimate — no files, no download, ~10% out.
# `bge-m3` loads the real vocabulary and is what production should use; it needs
# tokenizer.json on disk, and a missing file is a startup failure rather than a
# silent fallback (the two produce different chunk boundaries, so choosing one
# by accident would make the same document chunk differently on two machines).
#
#   uv run python scripts/fetch_models.py --tokenizer-only   # ~17 MB, no GPU
#
# Changing this after ingesting anything requires a re-chunk: the existing
# chunks were sized by the old counter.
RAG_INGESTION__TOKENIZER=heuristic
RAG_INGESTION__TOKENIZER_PATH=./var/models/bge-m3/tokenizer.json

# --- Model service, server side (only on the GPU box) ----------------------
# Its own process with its own prefix — it needs a device and no database,
# the API needs a database and no device. Nothing below is read by the API.
#
#   uv sync --extra gpu
#   uv run python scripts/fetch_models.py
#   uv run rag-model-service
#
# MODEL_SERVICE_PORT=8001
# MODEL_SERVICE_DEVICE=cuda
# MODEL_SERVICE_API_KEY=
# MODEL_SERVICE_EMBEDDING_MODEL_PATH=./var/models/bge-m3
# MODEL_SERVICE_RERANKER_MODEL_PATH=./var/models/bge-reranker-v2-m3
# Set to the snapshot revision you downloaded. Stamped onto every chunk row, and
# without it a weights change is undetectable — which makes the only safe
# migration a full re-embed of the corpus.
# MODEL_SERVICE_EMBEDDING_MODEL_VERSION=unknown
# Drops ~1.2 GB of VRAM. Needed on a card too small to hold both models.
# MODEL_SERVICE_RERANKER_ENABLED=true
# Sized for a 6 GB card. NOT BGE-M3's 8192 window: attention memory is quadratic
# in sequence length and a batch at 8192 does not fit. Chunks target 512 tokens,
# so nothing legitimate is refused — and over-length input is rejected rather
# than truncated, because a truncated chunk yields a vector that looks perfectly
# valid and is missing the end of the text.
# MODEL_SERVICE_MAX_SEQUENCE_TOKENS=1024
# MODEL_SERVICE_MAX_BATCH_TOKENS=8192
# `stub` serves the same HTTP contract with deterministic fake vectors and no
# torch. Useful on a machine with no GPU; it reports embedding_model='stub' in
# /v1/info, which is then stamped into every chunk row it produces, so a corpus
# embedded by accident says so in the database.
# MODEL_SERVICE_BACKEND=flag
