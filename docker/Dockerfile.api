# syntax=docker/dockerfile:1.7
#
# Multi-stage build for the API and the ingestion worker — same image, different
# CMD (`rag-worker`). The model service has its own CUDA-based Dockerfile
# (Dockerfile.model); this image stays CPU-only and small, which is the entire
# payoff of putting an HTTP boundary between them (docs/adr/0004).

# --------------------------------------------------------------------------
# Stage 1 — builder: resolve dependencies into a self-contained virtualenv.
# --------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS builder

# uv resolves and installs 10-100x faster than pip. Copying the static binary
# from the official image avoids a bootstrap pip install.
COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /build
RUN uv venv "$VIRTUAL_ENV"

# Dependency layer. We copy only the manifest and stub out the package so this
# layer's cache key depends on pyproject.toml alone — editing application code
# then rebuilds in seconds instead of re-resolving the dependency tree.
# Both packages are stubbed, because hatch is configured to build both and a
# missing directory fails the build before a single dependency is resolved.
# `model_service` is a few hundred kilobytes of pure Python here; what this
# image does *not* get is the `gpu` extra, and therefore not torch.
COPY pyproject.toml README.md ./
RUN mkdir -p src/rag src/model_service \
    && touch src/rag/__init__.py src/model_service/__init__.py
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install .

# BGE-M3's vocabulary, so the worker can size chunks exactly rather than with
# the estimator. 17 MB, and fetched in the *builder* — huggingface-hub is a
# build-time tool here and has no business in the runtime image. Only the one
# JSON file is copied forward.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install huggingface-hub
COPY scripts/fetch_models.py ./scripts/fetch_models.py
RUN python scripts/fetch_models.py --tokenizer-only --root /opt/models

# Source layer. --no-deps because the dependency set is already installed above.
# TODO(M13): commit a uv.lock and switch to `uv sync --frozen` for byte-for-byte
# reproducible builds. Acceptable to defer while the dependency set is churning.
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --no-deps --force-reinstall .

# --------------------------------------------------------------------------
# Stage 2 — runtime: the venv only. No compilers, no uv, no build context.
# --------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONFAULTHANDLER=1 \
    PATH="/opt/venv/bin:$PATH"

# Run as a non-root user. A container escape should not begin with root.
RUN groupadd --system --gid 1001 rag \
    && useradd --system --uid 1001 --gid rag --create-home --shell /usr/sbin/nologin rag

COPY --from=builder --chown=rag:rag /opt/venv /opt/venv

# The tokenizer, and the configuration that makes the worker use it. Under
# /opt rather than /var/lib/rag because the latter is a VOLUME, and a volume
# mount shadows whatever the image baked into that path at runtime — the file
# would be present at build time and gone the moment the container starts.
COPY --from=builder --chown=rag:rag /opt/models /opt/models
ENV RAG_INGESTION__TOKENIZER=bge-m3 \
    RAG_INGESTION__TOKENIZER_PATH=/opt/models/bge-m3/tokenizer.json

# Blob storage root (docs/adr/0009). Created here, owned by the app user,
# because the container runs unprivileged and cannot create a directory under
# `/app` at startup — which is exactly how the default `./var/blobs` failed this
# image's smoke test.
#
# An absolute path outside the working directory, and declared a VOLUME, so it
# is obvious that this data must outlive the container. The filesystem adapter
# is single-node regardless: with more than one replica this needs to be a
# shared volume, or the S3 adapter.
ENV RAG_INGESTION__BLOB_ROOT=/var/lib/rag/blobs
RUN mkdir -p "$RAG_INGESTION__BLOB_ROOT" && chown -R rag:rag /var/lib/rag
VOLUME ["/var/lib/rag"]

WORKDIR /app
USER rag

EXPOSE 8000

# Docker's healthcheck can restart the container, so it must probe LIVENESS
# (/health), never readiness. Pointing this at /ready would restart every API
# container during a brief Postgres blip — turning a degradation into an outage.
# Uses urllib because the slim image ships no curl or wget.
HEALTHCHECK --interval=15s --timeout=3s --start-period=15s --retries=3 \
    CMD python -c "import sys,urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2).status == 200 else 1)"

# One process per container; scale with replicas, not --workers. Keeps signal
# handling, logging, and per-container resource limits comprehensible.
CMD ["uvicorn", "rag.api.asgi:app", "--host", "0.0.0.0", "--port", "8000"]
