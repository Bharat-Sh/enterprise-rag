# syntax=docker/dockerfile:1.7
#
# The GPU model service: BGE-M3 embeddings and cross-encoder reranking.
#
# Separate from Dockerfile.api on purpose (docs/adr/0004). This image is 5-7 GB
# because torch bundles the CUDA runtime; the API image is a few hundred
# megabytes and needs no GPU node. Sharing one image would have forced the API
# to carry all of this to reach a model it never loads.
#
#   docker compose -f docker/compose.yml --profile gpu up -d
#
# Requires the NVIDIA Container Toolkit on the host. On Windows the usual local
# workflow is to skip this entirely and run the service natively — same code,
# same contract, and no 7 GB rebuild after every edit. See CLAUDE.md.

# --------------------------------------------------------------------------
# Stage 1 — builder.
# --------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS builder

COPY --from=ghcr.io/astral-sh/uv:0.5 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /build
RUN uv venv "$VIRTUAL_ENV"

# The `gpu` extra is what pulls torch and FlagEmbedding. The Linux torch wheels
# bundle the CUDA runtime libraries, so no `nvidia/cuda` base image is needed —
# only the host driver, which the container toolkit exposes. That keeps this
# image on the same Debian base as the API, which is one fewer base to patch.
COPY pyproject.toml README.md ./
RUN mkdir -p src/rag src/model_service \
    && touch src/rag/__init__.py src/model_service/__init__.py
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install ".[gpu]"

COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --no-deps --force-reinstall .

# --------------------------------------------------------------------------
# Stage 2 — runtime.
# --------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONFAULTHANDLER=1 \
    PATH="/opt/venv/bin:$PATH" \
    # Nothing may reach the hub at runtime. Weights come from a mounted volume;
    # if one is missing we want a loud startup failure, not a silent multi-
    # gigabyte download inside a container that is meant to be immutable.
    HF_HUB_OFFLINE=1

RUN groupadd --system --gid 1001 rag \
    && useradd --system --uid 1001 --gid rag --create-home --shell /usr/sbin/nologin rag

COPY --from=builder --chown=rag:rag /opt/venv /opt/venv

# Weights are NOT baked in. 2.3 GB of model in an image layer means every code
# change reships them, and the weights version independently of this code
# anyway. Populate the volume once:
#
#   uv run python scripts/fetch_models.py --root ./var/models
#
# and mount it here. A missing path is a startup failure with a legible message.
ENV MODEL_SERVICE_EMBEDDING_MODEL_PATH=/opt/models/bge-m3 \
    MODEL_SERVICE_RERANKER_MODEL_PATH=/opt/models/bge-reranker-v2-m3
RUN mkdir -p /opt/models && chown -R rag:rag /opt/models
VOLUME ["/opt/models"]

WORKDIR /app
USER rag

EXPOSE 8001

# Liveness, never readiness — a healthcheck can restart the container, and
# readiness is false for the 20-60 seconds it takes to load two models onto the
# GPU. Probing /ready here would restart the service forever, never once
# reaching the point where it works. `start-period` is generous for the same
# reason.
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD python -c "import sys,urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8001/health', timeout=3).status == 200 else 1)"

# One process. Model weights are per-process, so a second worker is a second
# copy in VRAM — an immediate out-of-memory error on any card this fits on at
# all. Scale with GPUs, not with workers.
CMD ["rag-model-service"]
